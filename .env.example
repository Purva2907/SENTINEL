# ========================================================
# SENTINEL ENVIRONMENT CONFIGURATION
# ========================================================

# Environment Mode (development | production)
ENV_MODE=development

# Database Configuration (DATABASE_MODE: sqlite | local | mongodb)
DATABASE_MODE=sqlite
SQLITE_DB_PATH=data/sentinel.db
MONGO_URL=mongodb://localhost:27017

# JWT Security Configuration
JWT_SECRET=super-secret-key-change-me-for-production-min-16-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence & Upload Storage Directory
UPLOAD_DIR=data/uploads

# LLM API Keys (Optional - offline autonomous fallback is active by default)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Node.js Mail Service (Nodemailer) Configuration
MAIL_SERVICE_PORT=5001
MAIL_SERVICE_BASE_URL=http://localhost:5001
MAIL_SERVICE_URL=http://localhost:5001/api/contact
CONTACT_EMAIL=investigations@sentinel-forensics.org
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SENTINEL Forensics" <no-reply@sentinel-forensics.org>

# Application & CORS Origins
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
